{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "ConnectionString": "",
    "ResetOnStart": false,
    "Seed": false
  },
  "Jwt": {
    "Issuer": "barnabas",
    "Audience": "barnabas",
    "SigningKey": "",
