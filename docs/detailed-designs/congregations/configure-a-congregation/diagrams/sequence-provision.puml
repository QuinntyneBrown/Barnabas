@startuml
title UML sequence behaviour - Configure a congregation: provision
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Administrator / congregation member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "Planned CongregationConfigurationComponent / BoardComponent" as page
  participant "ICongregationService / CONGREGATION_SERVICE (planned)" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "CongregationsController (planned)" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "ProvisionCongregationCommandHandler / ConfigureCongregationCommandHandler (planned)" as handler
  participant "Congregation" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Submit congregation name and slug
page -> client : provision(values)
client -> api : POST /congregations
api -> handler : Validate; require Administrator [L2-001]
alt Not administrator
  handler --> api : 403; no write
else Valid administrator request
  handler -> entity : Create congregation with immutable slug
  handler -> db : Insert under unique slug index
  alt Duplicate slug
    db --> handler : Expected unique violation
    handler --> api : 409 [L2-001 AC2]
  else Created
    db --> handler : Commit
    handler --> api : Identifier and display name
    api --> client : 201
    client --> page : Show saved congregation
  end
end
@enduml
