@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Configure a congregation
Person(actor, "Administrator / congregation member", "Configure a congregation")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "Planned CongregationConfigurationComponent / BoardComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Configure a congregation")
  ContainerDb(db, "Barnabas database", "SQL Server", "Congregation")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through ICongregationService / CONGREGATION_SERVICE (planned)", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
