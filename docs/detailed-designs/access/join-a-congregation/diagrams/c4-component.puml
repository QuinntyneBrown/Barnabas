@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Join a congregation
Container(web, "JoinInviteComponent / CreateProfileComponent / AwaitingApprovalComponent (planned)", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "InvitesController / JoiningController (planned)", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "RedeemInviteCodeCommandHandler / SubmitJoiningProfileCommandHandler (planned)", "Application", "Join a congregation")
  Component(entity, "InviteCode / JoiningSession / Member", "Domain", "Feature state and rules")
  Component(store, "InvitationStore (IInvitationStore, planned)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through IInvitationService / INVITATION_SERVICE (planned)", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
@enduml
