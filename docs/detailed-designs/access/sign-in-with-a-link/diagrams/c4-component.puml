@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Sign in with a link
Container(web, "SignInComponent / SignInLandingComponent", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "SessionsController", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "RequestSignInLinkCommandHandler / ExchangeSignInTokenCommandHandler", "Application", "Sign in with a link")
  Component(entity, "SignInToken / Session", "Domain", "Feature state and rules")
  Component(store, "AuthenticationStore (IAuthenticationStore)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through ISessionService / SESSION_SERVICE", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
System_Ext(external, "Email delivery provider", "Planned adapter behind IEmailSender")
Rel(handler, external, "Uses configured adapter")
@enduml
