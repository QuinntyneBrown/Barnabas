@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Sign in with a link
class SignInToken {
  +Guid MemberId
  +string TokenHash
  +DateTimeOffset ExpiresAt
  +DateTimeOffset? ConsumedAt
  +HasExpired(asOf: DateTimeOffset): bool
}
class Session {
  +Guid Id
  +Guid MemberId
  +Guid CongregationId
  +IsLive(asOf: DateTimeOffset): bool
}
interface IAuthenticationStore {
  +TryConsumeSignInTokenAsync(hash: string, asOf: DateTimeOffset): Task<SignInToken?>
}
class ExchangeSignInTokenCommand {
  +string Token
}
class ExchangeSignInTokenCommandHandler {
  +Handle(command: ExchangeSignInTokenCommand): Task<SessionResult>
}
ExchangeSignInTokenCommandHandler ..> ExchangeSignInTokenCommand : handles
ExchangeSignInTokenCommandHandler ..> IAuthenticationStore : consumes through
ExchangeSignInTokenCommandHandler ..> Session : creates
IAuthenticationStore --> SignInToken : returns
@enduml
