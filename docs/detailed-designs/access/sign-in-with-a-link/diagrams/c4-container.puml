@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in with a link

Person(member, "Member", "A parishioner returning to the board")
System_Boundary(barnabas, "Barnabas") {
  Container(spa, "Barnabas web", "Angular", "Sign-in and check-your-email screens")
  Container(api, "Barnabas API", "ASP.NET Core", "Issues and redeems sign-in tokens")
  ContainerDb(db, "Barnabas database", "SQL Server", "Members and sign-in tokens")
}
System_Ext(email, "Email provider", "Delivers the sign-in link")

Rel(member, spa, "Enters an email address in", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Stores the token hash", "EF Core")
Rel(api, email, "Sends the link", "SMTP")
Rel(member, api, "Follows the link to exchange it", "HTTPS")
@enduml
