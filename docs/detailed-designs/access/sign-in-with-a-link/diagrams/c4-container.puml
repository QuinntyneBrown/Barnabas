@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Sign in with a link
Person(actor, "Member", "Sign in with a link")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "SignInComponent / SignInLandingComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Sign in with a link")
  ContainerDb(db, "Barnabas database", "SQL Server", "SignInToken / Session")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through ISessionService / SESSION_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
System_Ext(external, "Email delivery provider", "Planned adapter behind IEmailSender")
Rel(api, external, "Uses configured adapter")
@enduml
