@startuml
title UML sequence behaviour - Sign in with a link: exchange
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "SignInComponent / SignInLandingComponent" as page
  participant "ISessionService / SESSION_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "SessionsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "RequestSignInLinkCommandHandler / ExchangeSignInTokenCommandHandler" as handler
  participant "SignInToken / Session" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Follow emailed link
page -> client : exchange(token)
client -> api : POST /sessions
api -> handler : ExchangeSignInTokenCommand
handler -> db : Begin target transaction; UPDATE unconsumed token by hash [L2-016]
db --> handler : Affected rows and token
alt No winning row or token expired
  handler -> db : Roll back
  handler --> api : SignInTokenNotRedeemableException [L2-015]
  api --> client : 410
  client --> page : Expired or used link; offer another
else Valid winning token
  handler -> db : Load member; congregation and role from record [L2-014]
  db --> handler : Member
  handler -> entity : Create Session and hashed RefreshToken
  handler -> db : Persist and commit (atomic target operation)
  db --> handler : Commit
  handler --> api : SessionResult with signed access token and sid
  api --> client : 200; HttpOnly refresh cookie
  client --> page : Approved board or pending approval screen
end
@enduml
