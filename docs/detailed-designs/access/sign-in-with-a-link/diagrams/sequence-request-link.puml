@startuml
title UML sequence behaviour - Sign in with a link: request link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "SignInComponent / SignInLandingComponent" as page
  participant "ISessionService / SESSION_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "SessionsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "RequestSignInLinkCommandHandler / ExchangeSignInTokenCommandHandler" as handler
  participant "SignInToken / Session" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Submit email address
page -> client : requestLink(emailAddress)
client -> api : POST /sessions/link
api -> api : Address and source limits [L2-017]
alt Limit exceeded
  api --> client : 429 with Retry-After
else Within limit
  api -> handler : RequestSignInLinkCommand
  handler -> db : Queue bounded address-processing work (planned)
  db --> handler : Work accepted
  handler --> api : Accepted regardless of membership [L2-013]
  api --> client : 202, identical body
  client --> page : Show CheckYourEmailComponent [L2-012]
  handler -> db : Worker finds member through authentication store
  alt Registered eligible member
    handler -> entity : Create 15-minute token
    handler -> db : Store hash; queue delivery through IEmailSender
    db --> handler : Persisted
  else Address unknown
    handler -> handler : Discard; no link dispatched [L2-013]
  end
end
@enduml
