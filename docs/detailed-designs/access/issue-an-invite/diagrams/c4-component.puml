Container(web, "InviteCodeComponent (planned)", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "InvitesController (planned)", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
