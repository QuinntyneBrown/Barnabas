@startuml
title UML sequence behaviour - End a session: sign out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "YouComponent / ConfirmDialogComponent" as page
  participant "ISessionService / SESSION_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "SessionsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "RefreshSessionCommandHandler / SignOutCommandHandler" as handler
  participant "Session / RefreshToken" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Choose sign out
page -> page : Open ConfirmDialogComponent
alt Cancel
  page --> actor : Keep session
else Confirm
  page -> client : signOut()
  client -> api : DELETE /sessions
  api -> handler : SignOutCommand; sid from verified context
  handler -> db : Revoke Session by sid and its refresh tokens [L2-019]
  db --> handler : Revocation committed
  handler --> api : Completed
  api --> client : 204; remove refresh cookie
  client --> page : Clear token and show landing
  client -> api : Attempt old access or refresh token
  api -> db : Load session; revoked
  db --> api : Not live
  api --> client : 401 [L2-019]
end
@enduml
