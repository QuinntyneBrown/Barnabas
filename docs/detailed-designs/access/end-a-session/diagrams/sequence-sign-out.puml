@startuml
title UML sequence behaviour — Signing out, and both tokens afterwards
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "YouComponent" as page
  participant "ConfirmSignOutDialog" as dialog
end box
box "Backend — Barnabas API" #D1FADF
  participant "SessionsController" as controller
  participant "SessionValidator" as sv
end box
box "Backend — Application and Domain" #ECFDF3
  participant "SignOutCommandHandler" as handler
  participant "Session" as session
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Choose Sign out
page -> dialog : Ask to confirm
actor -> dialog : Confirm
dialog -> controller : DELETE /sessions
controller -> handler : Send SignOutCommand, naming the session from the sid claim
handler -> db : Load the session
db --> handler : Session
handler -> session : Revoke, per L2-019
session --> handler : Revoked, and its refresh token with it
handler -> db : Save
handler --> controller : Done
controller --> page : 204 No Content
page -> page : Discard the access token held in memory
page --> actor : The public landing screen
== the access token from that session is presented again ==
actor -> sv : GET /board with the still-unexpired access token
sv -> db : Read the session named by sid
db --> sv : Session, revoked
sv --> actor : 401 Unauthorized
== the refresh token from that session is presented again ==
actor -> controller : POST /sessions/refresh with the revoked token
controller -> db : Find the token by hash
db --> controller : Token, on a revoked session
controller --> actor : 401 Unauthorized
== the member's other device is unaffected ==
actor -> sv : GET /board with the access token from a second session
sv -> db : Read that session
db --> sv : Session, live
sv --> actor : 200 OK
@enduml
