@startuml
!pragma layout smetana
title Class structure — End a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
hide empty members

class Session {
  +Guid Id
  +Guid MemberId
  +Guid CongregationId
  +DateTimeOffset OpenedOn
  +DateTimeOffset? RevokedOn
  +IsLive(DateTimeOffset) : bool
  +Revoke(DateTimeOffset) : void
}
class RefreshToken {
  +Guid Id
  +Guid SessionId
  +string TokenHash
  +DateTimeOffset ExpiresOn
  +DateTimeOffset? RevokedOn
  +Guid? ReplacedById
  +IsActive(DateTimeOffset) : bool
  +Rotate(DateTimeOffset) : RefreshToken
  +Revoke(DateTimeOffset) : void
}
class RefreshSessionCommand {
  +string RefreshToken
}
class SignOutCommand {
}
class SessionResult {
  +Guid SessionId
  +string AccessToken
  +string RefreshToken
  +DateTimeOffset ExpiresOn
}
class JwtIssuer {
  +Issue(Member, Session) : SessionResult
}
class Member {
  +Guid Id
  +Guid CongregationId
}

Session --> Member : belongs to
Session *-- RefreshToken : is held by exactly one live
RefreshSessionCommand ..> RefreshToken : rotates atomically
SignOutCommand ..> Session : revokes
RefreshToken --> RefreshToken : replaced by
JwtIssuer --> SessionResult : returns
JwtIssuer ..> Session : stamps the sid claim from
@enduml
