@startuml
title UML sequence behaviour — Editing a listing, and an edit by someone who does not own it
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "MyListingsComponent" as page
  participant "EditListingComponent" as form
end box
box "Backend — Barnabas API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Application and Domain" #ECFDF3
  participant "AuthorisationBehaviour" as behaviour
  participant "EditListingCommandHandler" as handler
  participant "Listing" as entity
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Open my listings
page --> actor : Each listing with its kind, status, and open request count
note over page : L2-035 makes the count a link to the requests\nthemselves, so a listing leads to the people\nasking for it.
actor -> page : Choose Edit
page -> form : Open, headed as an edit and populated
actor -> form : Save changes
form -> controller : PUT /listings/{id}
controller -> behaviour : Send EditListingCommand
behaviour -> db : Load the listing named by IRequireOwnership
db --> behaviour : Listing with its owner
alt the caller owns it
  behaviour -> handler : Invoke
  handler -> entity : Apply the changes
  entity --> handler : Updated
  handler -> db : Save
  handler --> controller : Result
  controller --> form : 200 OK
  form --> actor : Return to my listings
else the caller does not
  behaviour --> controller : L2-041 ownership failure
  controller --> form : 403 Forbidden
  form --> actor : Report that the listing is not theirs
end
note over entity : The kind cannot be changed. A Lend listing\ncannot become a Sell listing, because the terms\nit carries are not interchangeable.
@enduml
