@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Manage my listings
class GetMyListingsQuery {
  +bool IncludeClosed
}
class MyListingDto {
  +Guid ListingId
  +ListingKind Kind
  +ListingStatus Status
  +int OpenRequestCount
}
class GetMyListingsQueryHandler {
  +Handle(query: GetMyListingsQuery): Task<IReadOnlyList<MyListingDto>>
}
class EditListingCommand <<planned>> {
  +Guid ListingId
  +string Title
  +byte[] RowVersion
}
class Listing {
  +Guid OwnerId
  +ListingKind Kind
  +string Title
}
interface "IRequireOwnership<Listing>" as ownership
EditListingCommand ..|> ownership : declares owner requirement
GetMyListingsQueryHandler ..> GetMyListingsQuery : handles
GetMyListingsQueryHandler ..> MyListingDto : projects
GetMyListingsQueryHandler --> Listing : reads
EditListingCommand ..> Listing : target
@enduml
