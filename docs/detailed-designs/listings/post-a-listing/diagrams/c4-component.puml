@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Post a listing
Container(web, "ChooseKindComponent / per-kind listing pages", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "ListingsController", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "PostLendListingCommandHandler / planned kind handlers", "Application", "Post a listing")
  Component(entity, "Listing / LoanTerms / planned AvailabilityWindow", "Domain", "Feature state and rules")
  Component(store, "BarnabasDbContext (IBarnabasDbContext)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through IListingService / LISTING_SERVICE", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
@enduml
