@startuml
title UML sequence behaviour - Post a listing: post lend
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "ChooseKindComponent / per-kind listing pages" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "ListingsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "PostLendListingCommandHandler / planned kind handlers" as handler
  participant "Listing / LoanTerms / planned AvailabilityWindow" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Open kind chooser; choose Lend [L2-026]
page --> actor : Show common fields and return date; no price [L2-027]
actor -> page : Submit details
page -> client : postLend(values)
client -> api : POST /listings/lend
api -> handler : PostLendListingCommand after validation
handler -> entity : Listing.PostLend(owner and congregation from context)
entity --> handler : Active listing
handler -> db : Add and SaveChangesAsync
db --> handler : Commit
handler --> api : PostedListingResult
api --> client : 201 and ListingId
client --> page : Show confirmation and three destinations [L2-033]
@enduml
