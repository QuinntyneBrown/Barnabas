@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Post a listing
Person(actor, "Member", "Post a listing")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "ChooseKindComponent / per-kind listing pages")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Post a listing")
  ContainerDb(db, "Barnabas database", "SQL Server", "Listing / LoanTerms / planned AvailabilityWindow")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IListingService / LISTING_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
