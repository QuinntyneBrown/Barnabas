@startuml
!pragma layout smetana
title Class structure — Post a listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
hide empty members

interface IForbidFields {
  +string[] ForbiddenFields
}
abstract class PostListingCommand {
  +string Title
  +string Description
  +string Category
  +string Neighbourhood
}
class PostLendListingCommand {
  +DateOnly ReturnBy
  +string Condition
  +string[] ForbiddenFields = { "price" }
}
class PostGiveListingCommand {
  +string Included
  +bool PickupOnly
  +string[] ForbiddenFields = { "price" }
}
class PostSellListingCommand {
  +decimal Price
  +string Condition
}
class PostHelpListingCommand {
  +AvailabilityWindow[] Windows
  +string AreaCovered
  +string[] ForbiddenFields = { "price", "photo" }
}
class Listing {
  +Guid Id
  +Guid CongregationId
  +Guid OwnerId
  +ListingKind Kind
  +ListingStatus Status
  +string Title
  +CloseOut(ListingStatus) : void
}
enum ListingKind {
  Lend
  Give
  Sell
  Help
}
class LoanTerms {
  +DateOnly ReturnBy
}
class SaleTerms {
  +decimal Price
}
class AvailabilityWindow {
  +DayOfWeek Day
  +TimeOnly StartsAt
  +TimeOnly EndsAt
}

PostListingCommand <|-- PostLendListingCommand
PostListingCommand <|-- PostGiveListingCommand
PostListingCommand <|-- PostSellListingCommand
PostListingCommand <|-- PostHelpListingCommand
IForbidFields <|.. PostLendListingCommand
IForbidFields <|.. PostGiveListingCommand
IForbidFields <|.. PostHelpListingCommand
Listing --> ListingKind : holds
Listing *-- LoanTerms : for Lend
Listing *-- SaleTerms : for Sell
Listing *-- AvailabilityWindow : for Help
@enduml
