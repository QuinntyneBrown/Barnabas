@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Post a listing
class PostLendListingCommand {
  +string Title
  +string Description
  +DateOnly? ReturnBy
}
interface IForbidFields
PostLendListingCommand ..|> IForbidFields : rejects price
class Listing {
  +Guid OwnerId
  +ListingKind Kind
  +ListingStatus Status
  +decimal? Price
  +PostLend(...): Listing
  +PostGive(...): Listing
  +PostSell(...): Listing
  +PostHelp(...): Listing
}
class LoanTerms {
  +DateOnly ReturnBy
}
class AvailabilityWindow <<planned>> {
  +Guid Id
  +DateTimeOffset StartsAt
  +DateTimeOffset EndsAt
}
class PostLendListingCommandHandler {
  +Handle(command: PostLendListingCommand): Task<PostedListingResult>
}
PostLendListingCommandHandler ..> PostLendListingCommand : handles
PostLendListingCommandHandler ..> Listing : creates
Listing "1" *-- "0..1" LoanTerms : Lend terms
Listing "1" *-- "0..*" AvailabilityWindow : planned Help windows
@enduml
