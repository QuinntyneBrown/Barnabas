@startuml
title UML sequence behaviour - Attach a listing photo: serve image
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "Goods listing forms / ListingPhotoComponent (planned)" as page
  participant "IListingPhotoService / LISTING_PHOTO_SERVICE (planned)" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "ListingPhotosController (planned)" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "AttachListingPhotoCommandHandler / GetListingPhotoQueryHandler (planned)" as handler
  participant "ListingPhoto / Listing" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
page -> client : Load board image when visible or approaching viewport [L2-106]
client -> api : GET /listings/{id}/photo?size=board; bearer token
api -> handler : GetListingPhotoQuery
handler -> db : Scoped visible listing and board derivative
db --> handler : Encoded derivative or absent
alt Foreign or absent
  handler --> api : 404
else Accessible
  handler --> api : Board bytes and verified Content-Type
  api --> client : Image bytes; nosniff; private cache policy [L2-102]
  client --> page : Object URL with reserved width/height
  page --> actor : Photo; below-fold loading remains lazy
end
@enduml
