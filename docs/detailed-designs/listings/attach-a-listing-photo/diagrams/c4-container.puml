@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Attach a listing photo
Person(actor, "Member", "Attach a listing photo")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "Goods listing forms / ListingPhotoComponent (planned)")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Attach a listing photo")
  ContainerDb(db, "Barnabas database", "SQL Server", "ListingPhoto / Listing")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IListingPhotoService / LISTING_PHOTO_SERVICE (planned)", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
