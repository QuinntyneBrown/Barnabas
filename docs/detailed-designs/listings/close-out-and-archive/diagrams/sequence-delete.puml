@startuml
title UML sequence behaviour — Deleting a listing permanently
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Owner" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "ArchivedListingsComponent" as page
  participant "ConfirmDeleteDialog" as dialog
end box
box "Backend — Barnabas API" #D1FADF
  participant "ListingsController" as controller
end box
box "Backend — Application and Domain" #ECFDF3
  participant "DeleteListingCommandHandler" as handler
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Choose Delete permanently
page -> dialog : Ask to confirm, stating the action cannot be undone
alt owner confirms
  actor -> dialog : Confirm
  dialog -> controller : DELETE /listings/{id}
  controller -> handler : Send DeleteListingCommand
  handler -> db : Remove the listing, its requests, and its threads in one unit of work
  note over handler : L2-040 makes deletion irreversible, so it\ntakes the conversations with it rather than\nleaving threads about nothing.
  db --> handler : Commit result
  handler --> controller : Done
  controller --> dialog : 204 No Content
  dialog --> actor : The wrapped-up list, without that listing
else owner cancels
  actor -> dialog : Cancel
  dialog --> page : Dismiss
  page --> actor : The listing remains
end
@enduml
