@startuml
title UML sequence behaviour - Close out and archive: delete
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "MyListingsComponent / planned ArchivedListingsComponent" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "ListingsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "CloseOutListingCommandHandler / planned lifecycle handlers" as handler
  participant "Listing / ListingStatus" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Delete listing
page -> page : Confirm irreversible deletion and conversation removal [L2-040]
alt Cancel
  page --> actor : Listing remains
else Confirm
  page -> client : delete(listingId)
  client -> api : DELETE /listings/{id}
  api -> handler : Authorised DeleteListingCommand
  handler -> db : Transaction: scoped listing and dependent rows
  db --> handler : Delete notifications, read marks, messages, threads, requests, photos, listing
  handler -> db : Commit
  db --> handler : Committed
  handler --> api : Completed
  api --> client : 204
  client --> page : Remove listing
  client -> api : GET /listings/{id}
  api --> client : 404
end
@enduml
