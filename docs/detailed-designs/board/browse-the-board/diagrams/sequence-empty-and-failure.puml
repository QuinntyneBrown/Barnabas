@startuml
title UML sequence behaviour — An empty board, and a board that fails to load
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "BoardComponent" as page
  participant "BoardStore" as store
  participant "ListingsApi" as client
end box
box "Backend — Barnabas API" #D1FADF
  participant "BoardController" as controller
end box

actor -> page : Open the board
page -> store : Read the listings signal
store -> client : Request the board
client -> controller : GET /board
alt the congregation has posted nothing
  controller --> client : 200 OK with an empty collection
  client --> store : Set an empty list
  store --> page : Empty
  page --> actor : Explain nothing is posted yet and offer to post the first listing
  note over page : L2-045 treats an empty board as an invitation\nrather than an error.
else the request fails
  controller --> client : 5xx or no response
  client --> store : Set the error state
  store --> page : Error
  page --> actor : State that the board failed to load and offer to try again
else the request is still in flight
  store --> page : Loading
  page --> actor : Placard-shaped skeletons and a live region announcing the wait
  note over page : L2-046 requires the wait be announced to\nassistive technology, not only drawn.
end
@enduml
