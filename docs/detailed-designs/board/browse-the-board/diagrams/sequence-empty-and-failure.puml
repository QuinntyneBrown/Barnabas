@startuml
title UML sequence behaviour - Browse the board: empty and failure
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "BoardComponent / PlacardComponent" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "BoardController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "GetBoardQueryHandler" as handler
  participant "Listing / Member" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Open board
page -> page : Announce loading in live region [L2-046]
page -> client : board(kind)
client -> api : GET /board
alt Empty successful response
  api --> client : 200; listings=[] [L2-045]
  client --> page : Clear loading; set empty state
  page --> actor : Offer to post first listing
else Request failed
  api --> client : Failure
  client --> page : Clear loading; set failed signal
  page --> actor : Explain failure and offer retry [L2-047]
  actor -> page : Retry
  page -> client : Reload same kind
end
@enduml
