@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Browse the board
Person(actor, "Member", "Browse the board")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "BoardComponent / PlacardComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Browse the board")
  ContainerDb(db, "Barnabas database", "SQL Server", "Listing / Member")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IListingService / LISTING_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
