@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Search listings
Person(actor, "Member", "Search listings")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "SearchComponent / SearchResultsComponent (planned)")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Search listings")
  ContainerDb(db, "Barnabas database", "SQL Server", "Listing / BoardCursor")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through ISearchService / SEARCH_SERVICE (planned)", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
