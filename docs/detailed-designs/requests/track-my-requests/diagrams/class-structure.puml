@startuml
!pragma layout smetana
title Class structure — Track my requests
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
hide empty members

class GetMyRequestsQuery {
  +RequestStatus? Status
}
class GetMyRequestsQueryHandler {
  +Handle(GetMyRequestsQuery) : MyRequestDto[]
}
class MyRequestDto {
  +Guid RequestId
  +Guid ListingId
  +string ListingTitle
  +ListingKind Kind
  +string OwnerDisplayName
  +string Neighbourhood
  +string Terms
  +RequestStatus Status
  +DateTimeOffset CreatedOn
  +Guid? ThreadId
}
class ListingRequest {
  +Guid Id
  +Guid ListingId
  +Guid RequesterId
  +RequestStatus Status
}
enum RequestStatus {
  Pending
  Accepted
  Declined
}
class Listing {
  +Guid Id
  +Guid OwnerId
  +ListingKind Kind
  +string Title
}
class MessageThread {
  +Guid Id
  +Guid RequestId
}

GetMyRequestsQueryHandler ..> GetMyRequestsQuery : handles
GetMyRequestsQueryHandler --> MyRequestDto : returns
MyRequestDto ..> ListingRequest : projects
MyRequestDto ..> Listing : projects
MyRequestDto ..> MessageThread : carries the identifier of
ListingRequest --> RequestStatus : holds
@enduml
