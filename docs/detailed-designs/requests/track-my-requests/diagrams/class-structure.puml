@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Track my requests
class GetMyRequestsQuery {
  +RequestStatus? Status
}
class GetMyRequestsQueryHandler {
  +Handle(query: GetMyRequestsQuery): Task<IReadOnlyList<MyRequestDto>>
}
class MyRequestDto {
  +Guid RequestId
  +Guid ListingId
  +string Terms
  +RequestStatus Status
}
class RequestStore {
  +loadOutgoing(): Promise<void>
}
GetMyRequestsQueryHandler ..> GetMyRequestsQuery : handles
GetMyRequestsQueryHandler ..> MyRequestDto : projects
RequestStore ..> MyRequestDto : receives through IRequestService
@enduml
