@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Track my requests
Person(actor, "Member", "Track my requests")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "OutgoingRequestsComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Track my requests")
  ContainerDb(db, "Barnabas database", "SQL Server", "ListingRequest / Listing / Member")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IRequestService / REQUEST_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
