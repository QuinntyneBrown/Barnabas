@startuml
!pragma layout smetana
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Accept a request

Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes POST /requests/{requestId}/accept")
  Component(handler, "AcceptRequestCommandHandler", "MediatR handler", "Applies the acceptance and opens a thread")
  Component(entity, "ListingRequest", "Domain entity", "Owns the request state machine")
  Component(thread, "MessageThread", "Domain entity", "Carries the listing and both members")
  ComponentDb(db, "Barnabas database", "SQL Server", "Persists requests and threads")
}
Rel(ctrl, handler, "Sends AcceptRequestCommand")
Rel(handler, entity, "Loads and applies Accept")
Rel(handler, thread, "Creates for the accepted request")
Rel(handler, db, "Persists in one unit of work", "EF Core")
@enduml
