@startuml
title UML sequence behaviour — Accept a request, and accept racing decline
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Listing owner" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "IncomingRequestsComponent" as page
  participant "RequestsApi" as client
end box
box "Backend — Barnabas API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Application and Domain" #ECFDF3
  participant "AcceptRequestCommandHandler" as handler
  participant "ListingRequest" as entity
  participant "MessageThread" as thread
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Accept the request
page -> client : Build typed request
client -> controller : POST /requests/{requestId}/accept
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send AcceptRequestCommand
handler -> db : Load the request and its listing, with its row version
db --> handler : Request and listing
alt request is pending
  handler -> entity : Apply the L2-060 acceptance transition
  entity --> handler : Status set to Accepted
  handler -> thread : Open, naming the request
  thread --> handler : Thread
  handler -> db : Save both in one unit of work, checking the row version
  alt the row version still matches
    db --> handler : Commit result
    handler --> controller : Request and thread identifiers
    controller --> client : 200 OK
    client --> page : Feature result
    page --> actor : Confirm the acceptance and offer the message thread
  else another decision committed first
    db --> handler : Concurrency conflict, or a duplicate on the thread's RequestId
    handler --> controller : Conflict
    controller --> client : 409 Conflict
    page --> actor : Report that the request was already decided
    note over db : L2-060 requires exactly one transition to\nsurvive an accept racing a decline, and at most\none thread for the request. The row version settles\nthe first, the unique RequestId the second.
  end
else request already decided
  entity --> handler : RequestAlreadyDecidedException
  controller --> client : 409 Conflict
  page --> actor : Report the request was already decided
end
@enduml
