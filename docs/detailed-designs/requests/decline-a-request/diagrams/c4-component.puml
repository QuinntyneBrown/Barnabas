@startuml
!pragma layout smetana
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Decline a request

Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "RequestsController", "ASP.NET Core controller", "Exposes POST /requests/{requestId}/decline")
  Component(handler, "DeclineRequestCommandHandler", "MediatR handler", "Applies the decline decision")
  Component(entity, "ListingRequest", "Domain entity", "Owns the request state machine")
  ComponentDb(db, "Barnabas database", "SQL Server", "Persists requests")
}
Rel(ctrl, handler, "Sends DeclineRequestCommand")
Rel(handler, entity, "Loads and applies Decline")
Rel(handler, db, "Persists in one unit of work", "EF Core")
@enduml
