@startuml
!pragma layout smetana
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Decline a request

Person(owner, "Listing owner", "Decides the request")
System_Boundary(barnabas, "Barnabas") {
  Container(spa, "Barnabas web", "Angular", "Member-facing user interface")
  Container(api, "Barnabas API", "ASP.NET Core", "Application and domain logic")
  ContainerDb(db, "Barnabas database", "SQL Server", "Requests and notifications")
}
System_Ext(email, "Email provider", "Delivers notifications")

Rel(owner, spa, "Declines in", "HTTPS")
Rel(spa, api, "Calls", "JSON/HTTPS")
Rel(api, db, "Reads and writes", "EF Core")
Rel(api, email, "Queues requester notification", "SMTP")
@enduml
