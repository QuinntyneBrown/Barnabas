@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Decline a request
Person(actor, "Member", "Decline a request")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "IncomingRequestsComponent / ConfirmDialogComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Decline a request")
  ContainerDb(db, "Barnabas database", "SQL Server", "ListingRequest / MessageThread")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IRequestService / REQUEST_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
