@startuml
title UML sequence behaviour — Request to borrow a Lend listing
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Requester" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "RequestLendComponent" as page
  participant "RequestsApi" as client
end box
box "Backend — Barnabas API" #D1FADF
  participant "RequestsController" as controller
end box
box "Backend — Application and Domain" #ECFDF3
  participant "MakeLoanRequestCommandHandler" as handler
  participant "RequestEligibilityPolicy" as policy
  participant "ListingRequest" as entity
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Choose Request to borrow
page -> page : Collect message, pickup date, return date, acknowledgement per L2-054
actor -> page : Send request
page -> client : Build typed request
client -> controller : POST /listings/{listingId}/requests/loan
controller -> controller : Authenticate and apply endpoint policy
controller -> handler : Send MakeLoanRequestCommand
handler -> db : Load listing within the caller's congregation
db --> handler : Listing
handler -> policy : Apply L2-062 eligibility checks
policy --> handler : Eligible
alt request is valid
  handler -> entity : Create pending request with loan terms
  entity --> handler : Pending request
  handler -> db : Save changes in one unit of work
  db --> handler : Commit result
  handler --> controller : Typed result
  controller --> client : 201 Created
  client --> page : Feature result
  page --> actor : Present L2-058 confirmation naming the owner
else return date absent or acknowledgement withheld
  handler --> controller : Validation failure
  controller --> client : 400 ProblemDetails naming the field
  client --> page : Field errors
  page --> actor : Mark the invalid field and hold the screen
end
@enduml
