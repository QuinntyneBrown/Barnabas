@startuml
title UML sequence behaviour - Make a request: guards
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "RequestLendComponent / planned per-kind request pages" as page
  participant "IRequestService / REQUEST_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "RequestsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "MakeLoanRequestCommandHandler / planned kind handlers" as handler
  participant "ListingRequest / RequestEligibilityPolicy" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : Submit request
api -> handler : Validated kind-specific command
handler -> db : Load listing through congregation filter
db --> handler : Listing or absent
alt Absent or foreign
  handler --> api : 404
else Own listing or wrong kind
  handler -> entity : RequestEligibilityPolicy.Check [L2-062]
  entity --> handler : OwnListing or KindMismatch
  handler --> api : 400
else Inactive listing
  handler --> api : 409; no request
else Existing Pending request or concurrent index loser
  handler -> db : Read duplicate; unique index guards insert [L2-062 AC5]
  db --> handler : Duplicate
  handler --> api : 409; one pending request survives
else Eligible, including previously declined
  handler -> db : Insert new Pending request
  db --> handler : Commit
  handler --> api : 201
end
api --> client : Typed outcome
client --> page : Result; own listing offers no request action
@enduml
