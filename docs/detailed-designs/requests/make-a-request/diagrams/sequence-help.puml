@startuml
title UML sequence behaviour - Make a request: help
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "RequestLendComponent / planned per-kind request pages" as page
  participant "IRequestService / REQUEST_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "RequestsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "MakeLoanRequestCommandHandler / planned kind handlers" as handler
  participant "ListingRequest / RequestEligibilityPolicy" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Choose one displayed availability window [L2-057]
page -> client : askForHelp(listingId, windowId, message)
client -> api : POST /listings/{id}/requests/help
api -> handler : MakeHelpRequestCommand
handler -> db : Load scoped active Help listing and windows
db --> handler : Declared windows
alt Window not declared
  handler --> api : 400 naming windowId [L2-057]
  api --> client : Validation problem
  client --> page : Retain draft and reload window choices
else Declared window
  handler -> entity : Create Pending Help request with selected terms
  handler -> db : Guard active state and window; insert under unique index
  db --> handler : Commit or duplicate 409
  handler --> api : MadeRequestResult
  api --> client : 201
  client --> page : Confirmation and own-requests destination
end
@enduml
