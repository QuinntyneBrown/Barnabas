@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Export and erase personal data
class MemberErasure <<planned>> {
  +Guid MemberId
  +DateTimeOffset RequestedAt
  +ErasureStatus Status
  +DateTimeOffset? CompletedAt
}
enum ErasureStatus {
  Requested
  Processing
  Completed
}
class MemberExportDto <<planned>> {
  +MemberProfileDto Profile
  +IReadOnlyList<ListingDto> Listings
  +IReadOnlyList<RequestDto> Requests
  +IReadOnlyList<MessageDto> Messages
}
class ExportMemberDataQueryHandler <<planned>> {
  +Handle(query: ExportMemberDataQuery): Task<MemberExportDto>
}
class EraseMemberDataCommandHandler <<planned>> {
  +Handle(command: EraseMemberDataCommand): Task
}
MemberErasure --> ErasureStatus : lifecycle
ExportMemberDataQueryHandler ..> MemberExportDto : projects authorised data
EraseMemberDataCommandHandler --> MemberErasure : progresses idempotent work
@enduml
