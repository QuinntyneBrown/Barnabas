@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Find a thread
Container(web, "ThreadsComponent", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "ThreadsController", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "GetMyThreadsQueryHandler / AcceptRequestCommandHandler", "Application", "Find a thread")
  Component(entity, "MessageThread", "Domain", "Feature state and rules")
  Component(store, "BarnabasDbContext (IBarnabasDbContext)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through IThreadService / THREAD_SERVICE", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
@enduml
