@startuml
title UML sequence behaviour - Read and reply: read
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "ThreadComponent" as page
  participant "IThreadService / THREAD_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "ThreadsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "GetThreadQueryHandler / SendMessageCommandHandler" as handler
  participant "MessageThread / Message / ThreadReadMark" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Open thread
page -> client : get(threadId)
client -> api : GET /threads/{id}
api -> handler : GetThreadQuery
handler -> db : Load scoped thread and message page
db --> handler : Thread and displayed messages
handler -> entity : IsParty(caller) [L2-066]
alt Not a party or missing
  handler --> api : 404
  api --> client : Not found
else Party
  handler -> entity : Target MarkRead through returned messages only
  handler -> db : Monotonic read-mark upsert (planned)
  db --> handler : Commit; other reader unchanged
  handler --> api : ThreadDetailDto ordered by time and identifier
  api --> client : 200
  client --> page : Messages, listing link, other-member profile link [L2-068]
end
@enduml
