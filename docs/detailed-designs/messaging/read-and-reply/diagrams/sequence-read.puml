@startuml
title UML sequence behaviour — Opening a thread
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend — Barnabas web" #E0F2FE
  participant "ThreadComponent" as page
  participant "ThreadsApi" as client
end box
box "Backend — Barnabas API" #D1FADF
  participant "ThreadsController" as controller
end box
box "Backend — Application and Domain" #ECFDF3
  participant "GetThreadQueryHandler" as handler
  participant "MessageThread" as thread
end box
box "Backend — Infrastructure" #FFF4E5
  database "Barnabas database" as db
end box

actor -> page : Open a thread from the messages list
page -> client : Request the thread
client -> controller : GET /threads/{id}
controller -> handler : Send GetThreadQuery
handler -> db : Load the thread and its messages
db --> handler : Thread and messages
handler -> thread : Is the caller a party?
alt the caller is a party
  thread --> handler : Yes
  handler -> db : Move this member's read mark to now
  note over handler : L2-066 marks the thread read for this member\nonly. The other party's unread state is untouched.
  handler --> controller : Messages in ascending time order, with the listing
  controller --> client : 200 OK
  client --> page : Thread
  page --> actor : The conversation, the listing it concerns, and the request status
else the caller is not a party
  thread --> handler : No
  handler --> controller : Not found
  controller --> client : 404 Not Found
  note over controller : 404 rather than 403, so a thread's existence\nis not disclosed to a member outside it.
end
@enduml
