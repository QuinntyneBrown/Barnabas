@startuml
title UML sequence behaviour - Read and reply: send
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "ThreadComponent" as page
  participant "IThreadService / THREAD_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "ThreadsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "GetThreadQueryHandler / SendMessageCommandHandler" as handler
  participant "MessageThread / Message / ThreadReadMark" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Send message
page -> client : send(threadId, body)
client -> api : POST /threads/{id}/messages
api -> handler : SendMessageCommand; validate body [L2-067]
alt Empty or over 4000 characters
  handler --> api : 400 naming Body
  api --> client : Validation errors
  client --> page : Retain draft
else Valid body
  handler -> db : Load scoped thread
  db --> handler : Thread
  handler -> entity : Append(id, caller, body, now); check party
  alt Caller not a party
    entity --> handler : NotAPartyException
    handler --> api : 404
  else Party
    entity --> handler : Message
    handler -> db : SaveChangesAsync; target enabled recipient notification
    db --> handler : Commit
    handler --> api : MessageDto
    api --> client : 201
    client --> page : Append returned message and clear draft
  end
end
@enduml
