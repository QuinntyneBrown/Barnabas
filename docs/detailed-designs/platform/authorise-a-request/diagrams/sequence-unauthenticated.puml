@startuml
title UML sequence behaviour - Authorise a request: unauthenticated
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "ListingDetailComponent / IncomingRequestsComponent" as page
  participant "IListingService / IRequestService" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "JWT bearer pipeline / ListingsController / RequestsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "AuthorisationBehaviour / CloseOutListingCommandHandler" as handler
  participant "Session / Listing / RequestOwnership" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : Protected request
alt Missing, malformed, expired, or invalid signature
  api --> client : 401 [L2-093]
else Valid signature
  api -> db : SessionValidator loads sid
  db --> api : Session
  alt Absent sid or session no longer live
    api --> client : 401
  else Live session
    api -> handler : Target current member status/role policy; dispatch
    handler --> api : Authorised result
    api --> client : Feature response
  end
end
@enduml
