@startuml
title UML sequence behaviour - Authorise a request: not owner
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "ListingDetailComponent / IncomingRequestsComponent" as page
  participant "IListingService / IRequestService" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "JWT bearer pipeline / ListingsController / RequestsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "AuthorisationBehaviour / CloseOutListingCommandHandler" as handler
  participant "Session / Listing / RequestOwnership" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : Modify resource
api -> handler : Validation then AuthorisationBehaviour
handler -> db : IOwnerLookup within congregation
db --> handler : Scoped resource or absent
alt Absent or foreign
  handler --> api : 404
else Wrong owner
  handler --> api : ForbiddenException [L2-094]
  api --> client : 403
else Missing required role
  handler --> api : ForbiddenException [L2-095]
  api --> client : 403
else Authorised
  handler -> entity : Execute declared feature action
  entity --> handler : Result
  handler --> api : Feature result
  api --> client : Success
end
@enduml
