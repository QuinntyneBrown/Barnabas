@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Authorise a request
Container(web, "ListingDetailComponent / IncomingRequestsComponent", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "JWT bearer pipeline / ListingsController / RequestsController", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "AuthorisationBehaviour / CloseOutListingCommandHandler", "Application", "Authorise a request")
  Component(entity, "Session / Listing / RequestOwnership", "Domain / application contracts", "Feature state and rules")
  Component(store, "BarnabasDbContext (IBarnabasDbContext)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through IListingService / IRequestService", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
@enduml
