@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Limit abuse
class AbuseLimitOptions <<planned>> {
  +int RequestsPerWindow
  +TimeSpan Window
  +int FailedInviteThreshold
}
class RateLimitBucket <<planned>> {
  +string HashedKey
  +DateTimeOffset WindowStart
  +int Count
}
interface IRequestAdmissionService <<planned>> {
  +TryAdmit(key: string, now: DateTimeOffset): Task<AdmissionDecision>
}
class AdmissionDecision <<planned>> {
  +bool Admitted
  +TimeSpan RetryAfter
}
IRequestAdmissionService ..> AbuseLimitOptions : configured limits
IRequestAdmissionService --> RateLimitBucket : atomic counter operation
IRequestAdmissionService ..> AdmissionDecision : returns
@enduml
