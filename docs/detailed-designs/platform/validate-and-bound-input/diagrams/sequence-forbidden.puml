@startuml
title UML sequence behaviour - Validate and bound input: forbidden
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "PostLendComponent / fieldErrors" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "RequestBodyLimitMiddleware / ForbiddenFieldInspector" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "ValidationBehaviour / PostLendListingCommandValidator" as handler
  participant "PostLendListingCommand / Listing" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : POST Lend listing with price and legacyField
api -> api : ForbiddenFieldInspector reads raw property names
alt price present
  api --> client : 400 naming price [L2-096 AC5]
else Only legacyField present
  api -> api : JSON binding ignores unknown legacyField [L2-096 AC4]
  api -> handler : Validated known fields only
  handler -> db : Persist accepted model
  db --> handler : Commit; no legacyField stored
  handler --> api : Typed result
  api --> client : Success
end
@enduml
