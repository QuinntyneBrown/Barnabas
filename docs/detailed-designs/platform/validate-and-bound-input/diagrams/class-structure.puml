@startuml
!pragma layout smetana
title Class structure — Validate and bound input
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
hide empty members

class ValidationBehaviour<TRequest, TResponse> {
  -IEnumerable<IValidator<TRequest>> validators
  +Handle(TRequest, RequestHandlerDelegate, CancellationToken) : Task<TResponse>
}
interface IValidator<T> {
  +Validate(T) : ValidationResult
}
class ValidationResult {
  +bool IsValid
  +IList<ValidationFailure> Errors
}
class ValidationFailure {
  +string PropertyName
  +string ErrorMessage
}
class ValidationProblemDetails {
  +int Status
  +string Title
  +IDictionary<string, string[]> Errors
}
class MakeLoanRequestCommandValidator {
  +MakeLoanRequestCommandValidator()
}
class PostLendListingCommandValidator {
  +PostLendListingCommandValidator()
}
interface IForbidFields {
  +string[] ForbiddenFields
}
class ForbiddenFieldInspector {
  +Inspect(JsonElement, IForbidFields) : ValidationFailure[]
}
class PostLendListingCommand {
  +string[] ForbiddenFields
}

IValidator <|.. MakeLoanRequestCommandValidator
IValidator <|.. PostLendListingCommandValidator
IForbidFields <|.. PostLendListingCommand
ValidationBehaviour --> IValidator : resolves all registered
IValidator --> ValidationResult : returns
ValidationResult *-- ValidationFailure : collects
ValidationBehaviour ..> ValidationProblemDetails : builds from failures
ForbiddenFieldInspector ..> IForbidFields : reads the declared names from
ForbiddenFieldInspector --> ValidationFailure : produces
@enduml
