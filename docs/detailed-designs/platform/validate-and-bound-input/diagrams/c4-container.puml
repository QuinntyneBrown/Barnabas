@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Validate and bound input
Person(actor, "Member", "Validate and bound input")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "PostLendComponent / fieldErrors")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Validate and bound input")
  ContainerDb(db, "Barnabas database", "SQL Server", "PostLendListingCommand / Listing")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IListingService / LISTING_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
