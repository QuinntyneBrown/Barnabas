@startuml
title UML sequence behaviour - Validate and bound input: invalid
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "PostLendComponent / fieldErrors" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "RequestBodyLimitMiddleware / ForbiddenFieldInspector" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "ValidationBehaviour / PostLendListingCommandValidator" as handler
  participant "PostLendListingCommand / Listing" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Submit field outside bounds
page -> client : Typed request
client -> api : JSON body
api -> api : Enforce body bytes and JSON types [L2-096]
api -> handler : ValidationBehaviour runs IValidator
handler --> api : ValidationException; field name only
api --> client : 400 ValidationProblemDetails; no value echo
client --> page : Mark fields and focus first invalid control
note over db : Handler never writes
@enduml
