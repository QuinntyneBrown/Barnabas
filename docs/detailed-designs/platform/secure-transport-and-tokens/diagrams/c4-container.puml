@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Secure transport and tokens
Person(actor, "Member", "Secure transport and tokens")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "SessionStore / routed pages")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Secure transport and tokens")
  ContainerDb(db, "Barnabas database", "SQL Server", "Session / RefreshToken")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through ISessionService / TOKEN_SERVICE", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
