@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Scope queries to a congregation
Container(web, "BoardComponent / ListingDetailComponent", "Angular barnabas application", "Screen composition; signal state behind service contracts")
Container_Boundary(api, "Barnabas API") {
  Component(ctrl, "BoardController / ListingsController / JWT pipeline", "ASP.NET Core API", "Binding and dispatch; endpoint policies in the HTTP pipeline")
  Component(handler, "GetBoardQueryHandler / scoped command handlers", "Application", "Scope queries to a congregation")
  Component(entity, "Listing / ITenantOwned", "Domain / application contracts", "Feature state and rules")
  Component(store, "BarnabasDbContext (IBarnabasDbContext)", "Infrastructure implementation", "SQL Server persistence")
}
ContainerDb(db, "Barnabas database", "SQL Server", "Feature records")
Rel(web, ctrl, "Calls through IListingService / LISTING_SERVICE", "HTTPS")
Rel(ctrl, handler, "Dispatches", "MediatR 12.5.0")
Rel(handler, entity, "Reads or applies rules")
Rel(handler, store, "Uses persistence abstraction")
Rel(store, db, "Queries and saves", "EF Core / parameterised SQL")
@enduml
