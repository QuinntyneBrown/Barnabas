@startuml
title UML sequence behaviour - Scope queries to a congregation: anonymous
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "BoardComponent / ListingDetailComponent" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "BoardController / ListingsController / JWT pipeline" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "GetBoardQueryHandler / scoped command handlers" as handler
  participant "Listing / ITenantOwned" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : POST /sessions/link
api -> handler : RequestSignInLinkCommand
handler -> db : IAuthenticationStore lookup by normalised email
db --> handler : Authentication member record only
handler --> api : Accepted
api --> client : 202
opt Attempt business read with unresolved congregation
  handler -> db : Access Listings, Members, Requests, or Threads
  db --> handler : CongregationContextMissingException [L2-088 AC4]
  handler --> api : Refused without rows
end
@enduml
