@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Scope queries to a congregation
interface ITenantOwned {
  +Guid CongregationId
}
interface ICongregationContext {
  +bool IsResolved
  +Guid CongregationId
  +Guid MemberId
}
class BarnabasDbContext {
  +SaveChangesAsync(): Task<int>
}
class CongregationContext
class Listing {
  +Guid CongregationId
  +Guid OwnerId
}
interface IAuthenticationStore {
  +FindMemberByIdAsync(id: Guid): Task<Member>
}
CongregationContext ..|> ICongregationContext
BarnabasDbContext --> ICongregationContext : scopes instance queries
Listing ..|> ITenantOwned
BarnabasDbContext ..> Listing : filters / persists
class AuthenticationStore
AuthenticationStore ..|> IAuthenticationStore
AuthenticationStore --> BarnabasDbContext : deliberate unfiltered authentication lookups
@enduml
