@startuml
title UML sequence behaviour - Scope queries to a congregation: cross congregation
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "BoardComponent / ListingDetailComponent" as page
  participant "IListingService / LISTING_SERVICE" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "BoardController / ListingsController / JWT pipeline" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "GetBoardQueryHandler / scoped command handlers" as handler
  participant "Listing / ITenantOwned" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : Read or modify foreign resource
api -> api : Validate signature and live session
api -> handler : Dispatch with congregation A context
handler -> db : Query id AND CongregationId = A [L2-089, L2-091]
db --> handler : No row
handler --> api : NotFoundException
api --> client : 404 identical to absent identifier
note over db : No write; moderator role grants no cross-congregation access [L2-092]
@enduml
