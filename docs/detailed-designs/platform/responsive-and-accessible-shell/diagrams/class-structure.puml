@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Use the responsive and accessible shell
class AppShellComponent
class PublicShellComponent
class PrimaryNavComponent
class BottomNavComponent
class ConfirmDialogComponent {
  +open(): void
}
class ViewportService {
  +band: Signal<Band>
}
enum Band <<TypeScript string union>> {
  xs
  sm
  md
  lg
  xl
}
AppShellComponent *-- PrimaryNavComponent : header
AppShellComponent *-- BottomNavComponent : narrow layout
AppShellComponent ..> ConfirmDialogComponent : plain input / output primitive
PublicShellComponent ..> ConfirmDialogComponent : plain input / output primitive
ViewportService --> Band : exposes
@enduml
