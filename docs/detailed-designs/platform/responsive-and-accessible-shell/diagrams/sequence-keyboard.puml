@startuml
title UML sequence behaviour - Use the responsive and accessible shell: keyboard
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "AppShellComponent / PublicShellComponent" as page
  participant "Viewport contract (planned) / browser events" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "No API call for layout or focus" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "No backend behaviour for layout or focus" as handler
  participant "Navigation destinations / Band" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : First Tab [L2-111]
page --> actor : Reveal skip link
actor -> page : Activate skip link
page -> page : Focus main landmark
actor -> page : Traverse controls and open dialog
page -> page : Trap focus; keep indicator visible on current surface [L2-112]
page --> actor : Labels, heading, and accessible dialog name [L2-115]
actor -> page : Escape
page -> page : Close dialog; restore invoker focus
page -> page : Verify text and boundary contrast [L2-113]
note over api, db : No backend interaction for keyboard traversal
@enduml
