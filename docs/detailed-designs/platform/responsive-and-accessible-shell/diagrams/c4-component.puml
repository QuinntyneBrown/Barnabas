@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Component - Use the responsive and accessible shell
Container_Boundary(web, "Frontend - barnabas application") {
  Component(shell, "AppShellComponent / PublicShellComponent", "Angular", "Route composition and main landmark")
  Component(nav, "PrimaryNavComponent / BottomNavComponent", "Angular", "Ordered primary navigation")
  Component(domain, "PlacardComponent", "domain library", "Congregation-aware content")
  Component(primitives, "SkipLinkComponent / ConfirmDialogComponent", "components library", "Inputs and outputs; no router or Barnabas services")
}
Rel(shell, nav, "Composes chrome")
Rel(shell, domain, "Arranges content through pages")
Rel(shell, primitives, "Composes primitives")
Rel(domain, primitives, "Passes plain values")
@enduml
