@startuml
title UML sequence behaviour - Use the responsive and accessible shell: nav bands
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "AppShellComponent / PublicShellComponent" as page
  participant "Viewport contract (planned) / browser events" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "No API call for layout or focus" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "No backend behaviour for layout or focus" as handler
  participant "Navigation destinations / Band" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
actor -> page : Open screen at 375, 576, 768, 992, or 1200 px [L2-108]
page -> client : Browser media queries / viewport signal
client --> page : Current Band and reduced-motion preference
page -> page : Arrange primary or bottom navigation; preserve ordered destinations [L2-109]
page -> page : Fit content without horizontal overflow or clipped controls
page -> page : Size touch controls; suppress nonessential motion when requested [L2-110, L2-114]
page --> actor : Reachable destinations and readable content
note over api, db : No backend interaction for this behaviour
@enduml
