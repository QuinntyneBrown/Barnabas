@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Review reported listings
Person(actor, "Moderator", "Review reported listings")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "ModerationQueueComponent / ReportedListingComponent (planned)")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Review reported listings")
  ContainerDb(db, "Barnabas database", "SQL Server", "ListingModeration / ListingReport")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IModerationService / MODERATION_SERVICE (planned)", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
