@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure - Review reported listings
class ListingReport <<planned>> {
  +Guid Id
  +Guid CongregationId
  +Guid ListingId
  +Guid ReporterId
  +string Reason
  +string? Note
  +DateTimeOffset? ResolvedAt
}
class ListingModeration <<planned>> {
  +Guid ListingId
  +bool Flagged
  +DateTimeOffset? RemovedAt
  +byte[] RowVersion
  +ClearFlag(): void
  +Remove(asOf: DateTimeOffset): void
}
ListingModeration "1" <-- "*" ListingReport : reports against same listing
@enduml
