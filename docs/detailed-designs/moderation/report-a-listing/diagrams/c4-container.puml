@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Report a listing
Person(actor, "Member", "Report a listing")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "ListingDetailComponent / ReportListingComponent / ReportSentComponent (planned)")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Report a listing")
  ContainerDb(db, "Barnabas database", "SQL Server", "ListingReport / ListingModeration")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IReportService / REPORT_SERVICE (planned)", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
