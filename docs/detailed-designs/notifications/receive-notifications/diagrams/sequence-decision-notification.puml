@startuml
title UML sequence behaviour - Receive notifications: decision notification
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Member" as actor
box "Frontend - barnabas application and libraries" #E0F2FE
  participant "Request/message pages / planned NotificationsComponent" as page
  participant "IRequestService / IThreadService / planned INotificationService" as client
end box
box "Backend - Barnabas.Api HTTP pipeline" #D1FADF
  participant "RequestsController / ThreadsController" as api
end box
box "Backend - Barnabas.Application and Domain" #ECFDF3
  participant "Source command handlers / planned NotificationWriter" as handler
  participant "Notification / NotificationPreference" as entity
end box
box "Backend - Barnabas.Infrastructure" #FFF4E5
  database "SQL Server / scoped persistence" as db
end box
client -> api : POST /requests/{id}/accept or decline
api -> handler : Authorised decision command
handler -> db : Load Pending request and requester preference
db --> handler : Scoped state
handler -> entity : Decide; stage enabled requester notification [L2-071]
handler -> db : Save rowversion, notification, and thread only on acceptance
alt Concurrent decision or storage failure
  db --> handler : Roll back staged writes
  handler --> api : 409 for conflict; server error for storage failure
else Commit
  db --> handler : Committed
  handler --> api : Decision result
  api --> client : 200
end
@enduml
