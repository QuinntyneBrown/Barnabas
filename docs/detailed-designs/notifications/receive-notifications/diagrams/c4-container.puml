@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Container - Receive notifications
Person(actor, "Member", "Receive notifications")
System_Boundary(barnabas, "Barnabas") {
  Container(web, "barnabas web application", "Angular", "Request/message pages / planned NotificationsComponent")
  Container(api, "Barnabas API", "ASP.NET Core / MediatR 12.5.0", "Receive notifications")
  ContainerDb(db, "Barnabas database", "SQL Server", "Notification / NotificationPreference")
}
Rel(actor, web, "Uses", "HTTPS")
Rel(web, api, "Calls through IRequestService / IThreadService / planned INotificationService", "JSON / HTTPS")
Rel(api, db, "Reads and commits scoped state", "EF Core / parameterised SQL")
@enduml
